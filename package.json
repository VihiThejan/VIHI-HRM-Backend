{
  "name": "vihi-hrm-backend",
  "version": "1.0.0",
  "description": "Backend API for VIHI HRM System",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint . --ext .ts",
    "test": "jest --coverage",
    "seed:admin": "ts-node src/scripts/createAdmin.ts",
    "seed:rbac": "ts-node src/scripts/seedRBAC.ts",
    "migrate:admin": "ts-node src/scripts/migrateAdmin.ts",
    "create:rbac-admin": "ts-node src/scripts/createRBACAdmin.ts",
    "fix:intern-roles": "ts-node src/scripts/fixInternRoles.ts",
    "check:staff": "ts-node src/scripts/checkStaffId.ts",
    "reset:password": "ts-node src/scripts/resetPasswordByStaffId.ts"
  },
  "keywords": [
    "hrm",
    "api",
    "express",
    "mongodb"
  ],
  "author": "VIHI",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "date-fns": "^3.0.6",
    "docx": "^9.5.1",
    "docxtemplater": "^3.67.6",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "googleapis": "^169.0.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "pdfkit": "^0.14.0",
    "pizzip": "^3.2.0",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "winston": "^3.11.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.6",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "^0.13.9",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
